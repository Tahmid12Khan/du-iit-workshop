[0.520, "o", "```javascript\r\nfunction isValidBDPhone(s) {\r\n  if (typeof s !== 'string') return false;\r\n  return /^(?:01[3-9]\\d{8}|8801[3-9]\\d{8}|\\+8801[3-9]\\d{8})$/.test(s);\r\n}\r\n```\r\n\r\n"]
